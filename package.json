{
  "name": "openneox",
  "version": "3.5.2",
  "description": "Neox — open-source agent engine and CLI. Local-first, bring your own model.",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "main": "apps/cli/dist/cli/main.js",
  "bin": {
    "neox": "./apps/cli/dist/cli/main.js"
  },
  "files": [
    "apps/cli/dist/**/*.js",
    "apps/cli/dist/**/*.d.ts",
    "apps/cli/dist/**/*.md",
    "!apps/cli/dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:packages && tsup && node scripts/rebuild-native.cjs",
    "check:resource-integrity": "node scripts/check-resource-integrity.mjs",
    "check:boundaries": "node scripts/check-import-boundaries.mjs",
    "check:boundaries:update": "node scripts/check-import-boundaries.mjs --update && node scripts/sync-package-exports.mjs",
    "check:exports": "node scripts/sync-package-exports.mjs --check",
    "check:specifiers": "node scripts/check-specifier-resolution.mjs",
    "check:native-dialogs": "node scripts/check-native-dialogs.mjs",
    "check:arch": "npm run check:boundaries && npm run check:exports && npm run check:specifiers && npm run check:native-dialogs && npm run check:filesize && npm run check:mock-targets && npm run check:pw-timeout && npm run check:edition",
    "check:filesize": "node scripts/check-file-size-ratchet.mjs",
    "check:mock-targets": "node scripts/check-mock-targets.mjs",
    "check:edition": "node scripts/check-edition-boundaries.mjs",
    "check:pw-timeout": "node scripts/check-playwright-timeouts.mjs",
    "check:filesize:update": "node scripts/check-file-size-ratchet.mjs --update",
    "build:packages": "npm run build -w @neoxlabs/cloud && npm run build -w @neoxlabs/kernel && npm run build -w @neoxlabs/platform && npm run build -w @neoxlabs/sandbox && npm run build -w @neoxlabs/pptx-renderer && npm run build -w @neoxlabs/pptx-compose && npm run build -w @neoxlabs/core && npm run build -w @neoxlabs/sdk && npm run build -w @neoxlabs/evals",
    "schema:lint": "npm run build -w @neoxlabs/kernel && node scripts/schema-lint.mjs",
    "analyze:anthropic-cache-payload": "tsx scripts/analyze-anthropic-cache-payload.ts",
    "test": "vitest run",
    "test:all": "tsx scripts/test-runner.ts --all",
    "test:ci": "tsx scripts/test-runner.ts --ci",
    "test:watch": "vitest",
    "neox-test": "tsx packages/test-harness/src/cli.ts",
    "cdp-eval": "bash scripts/cdp-eval.sh",
    "neox-test:list": "tsx packages/test-harness/src/cli.ts list",
    "neox-test:smoke": "tsx packages/test-harness/src/cli.ts run --tier smoke --mode unit --skip-manual",
    "neox-test:checklist": "tsx packages/test-harness/src/cli.ts checklist --kind flow --tier core",
    "neox-test:checklist:cli": "tsx packages/test-harness/src/cli.ts checklist --surface cli --kind flow",
    "neox-test:flows:cli": "tsx packages/test-harness/src/cli.ts list --surface cli --kind flow",
    "neox-test:cap:cli": "tsx packages/test-harness/src/cli.ts list --surface cli --id cli.cap.",
    "neox-test:list:cli": "tsx packages/test-harness/src/cli.ts list --surface cli",
    "build:cli-binaries": "tsx scripts/build-cli-binaries.ts",
    "build:cli-binaries:current": "tsx scripts/build-cli-binaries.ts -- --platform=current",
    "build:legacy": "tsc && chmod +x apps/cli/dist/cli/main.js",
    "dev": "tsx scripts/cli-entry.mjs",
    "dev:cli": "node scripts/ensure-cli-native.cjs && echo '\\n✓ CLI 跑 apps/cli/dist (不会自动编译源码). 改过 kernel/core/cli 请先: npm run build -w @neoxlabs/kernel && npm run build -w @neoxlabs/core && npx tsup\\n' && node apps/cli/dist/cli/main.js",
    "dev:cli:rebuild": "npm run build -w @neoxlabs/kernel && npm run build -w @neoxlabs/core && npx tsup && npm run dev:cli",
    "dev:prod": "cross-env NEOX_API_BASE=https://neox-dev.com NEOX_GATEWAY_BASE=https://gateway.neox-dev.com NEOX_WEB_BASE=https://neox-dev.com npm run dev",
    "build:pet-renderer-3d": "node scripts/build-pet-renderer-plugin.cjs",
    "ui:build-icons": "node scripts/build-icon-subset.cjs && node scripts/build-jb-icons.cjs",
    "start": "node apps/cli/dist/cli/main.js",
    "clean": "rm -rf apps/cli/dist packages/core/dist packages/sdk/dist",
    "pretype-check": "npm run build:packages",
    "type-check": "tsc --project tsconfig.typecheck.json --noEmit",
    "prepublishOnly": "npm run clean && npm run build && npm run type-check",
    "postinstall": "node scripts/rebuild-native.cjs && node scripts/ensure-ripgrep.cjs",
    "setup:ripgrep": "node scripts/ensure-ripgrep.cjs --force",
    "unlink": "npm unlink -g @neoxlabs/cli",
    "setup-java-debug": "bash scripts/download-java-debug.sh",
    "check:licenses": "node scripts/check-license-metadata.mjs",
    "audit:comments": "node scripts/audit-comments.mjs"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "coding-agent",
    "llm",
    "byok"
  ],
  "author": "Neox Labs",
  "license": "Apache-2.0",
  "dependencies": {
    "@alcalzone/ansi-tokenize": "^0.2.2",
    "@andresaya/edge-tts": "^1.8.0",
    "@esotericsoftware/spine-webgl": "4.3.13",
    "@hono/node-server": "^1.19.14",
    "@iconify-json/devicon": "^1.2.62",
    "@iconify-json/logos": "^1.2.11",
    "@iconify-json/material-icon-theme": "^1.2.58",
    "@iconify-json/vscode-icons": "^1.2.45",
    "@neoxlabs/core": "0.0.0-placeholder",
    "@neoxlabs/kernel": "0.0.0-placeholder",
    "@neoxlabs/native": "0.0.0-placeholder",
    "@neoxlabs/platform": "2.6.0",
    "@neoxlabs/pptx-compose": "0.0.0-placeholder",
    "@neoxlabs/pptx-renderer": "0.0.0-placeholder",
    "@neoxlabs/sandbox": "0.0.0-placeholder",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@parcel/watcher": "^2.5.6",
    "@types/diff": "^7.0.2",
    "@types/js-yaml": "^4.0.9",
    "@vscode/ripgrep": "^1.17.0",
    "ajv": "^8.17.1",
    "ansi-escapes": "^7.2.0",
    "auto-bind": "^5.0.1",
    "axios": "^1.16.1",
    "better-sqlite3": "^12.6.2",
    "better-sqlite3-multiple-ciphers": "^12.6.2",
    "bonjour-service": "^1.3.0",
    "bytenode": "^1.5.7",
    "chalk": "^4.1.2",
    "chardet": "^2.1.1",
    "chokidar": "^4.0.3",
    "cli-cursor": "^4.0.0",
    "diff": "^8.0.4",
    "duck-duck-scrape": "^2.2.7",
    "electron-updater": "^6.8.3",
    "execa": "^8.0.1",
    "fast-glob": "^3.3.2",
    "glob": "^10.5.0",
    "hono": "^4.11.9",
    "https-proxy-agent": "^7.0.6",
    "iconv-lite": "^0.6.3",
    "ink": "^6.6.0",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "is-in-ci": "^2.0.0",
    "js-yaml": "^4.1.1",
    "jszip": "^3.10.1",
    "keytar": "^7.9.0",
    "mammoth": "^1.12.0",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "minimatch": "^9.0.4",
    "node-pty": "^1.1.0",
    "onnxruntime-node": "^1.27.0",
    "openai": "^4.28.0",
    "ora": "^8.0.1",
    "patch-console": "^2.0.0",
    "playwright-core": "^1.60.0",
    "prompts": "^2.4.2",
    "qrcode": "^1.5.3",
    "react": "^19.2.3",
    "react-reconciler": "^0.33.0",
    "sherpa-onnx-node": "^1.13.4",
    "signal-exit": "^4.1.0",
    "simple-git": "^3.36.0",
    "slice-ansi": "^7.1.2",
    "socks": "^2.8.3",
    "stack-utils": "^2.0.6",
    "string-width": "^8.1.0",
    "tree-sitter": "^0.21.1",
    "tree-sitter-typescript": "^0.23.2",
    "undici": "^6.19.8",
    "uqr": "^0.1.2",
    "widest-line": "^5.0.0",
    "wrap-ansi": "^9.0.2",
    "ws": "^8.19.0",
    "xlsx": "^0.18.5",
    "yoga-layout": "^3.2.1",
    "zod": "^3.22.4"
  },
  "optionalDependencies": {
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@aws-sdk/lib-storage": "^3.1084.0",
    "@changesets/cli": "^2.31.0",
    "@electron/fuses": "^2.1.3",
    "@electron/rebuild": "^4.0.1",
    "@iconify/react": "^6.0.2",
    "@monaco-editor/react": "^4.7.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.11.19",
    "@types/prompts": "^2.4.9",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@univerjs/preset-sheets-core": "^0.22.1",
    "@univerjs/presets": "^0.22.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "docx-preview": "^0.3.7",
    "electron": "^40.0.0",
    "electron-builder": "^26.15.3",
    "icon-gen": "^5.0.0",
    "ink-testing-library": "^4.0.0",
    "javascript-obfuscator": "^5.4.3",
    "katex": "^0.16.45",
    "mermaid": "^11.14.0",
    "monaco-editor": "0.55.1",
    "react-devtools-core": "^6.1.5",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.4",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.0.2",
    "terser": "^5.46.0",
    "three": "^0.183.2",
    "tsup": "^8.5.1",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18",
    "wait-on": "^8.0.2"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.11"
    },
    "read-yaml-file": "2.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neoxlabs/OpenNeox.git"
  },
  "homepage": "https://github.com/neoxlabs/OpenNeox"
}
