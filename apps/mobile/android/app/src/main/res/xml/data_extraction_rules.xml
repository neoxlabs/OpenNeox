<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ 备份/迁移规则.
  全部 disallow: 不让 Google 自动备份 / device-to-device 转移 app 数据, 防 token 跟着
  备份漂去新设备 / 第三方云. 用户换设备走重新登录, 是 commercial-grade 该有的行为.
-->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
  </device-transfer>
</data-extraction-rules>
