<%- include('../partials/head', { title: '注册' }) %>

<div class="auth-page">
  <div class="auth-card">
    <div class="auth-badge" aria-hidden="true">🌸</div>
    <h2>加入 Cece</h2>
    <p class="auth-subtitle">创建账号，开启优雅的宠物护理管理</p>
    <form method="POST" action="/auth/register">
      <div class="form-group">
        <label>用户名</label>
        <input type="text" name="username" class="form-control" required placeholder="请输入用户名" autocomplete="username">
      </div>
      <div class="form-group">
        <label>邮箱</label>
        <input type="email" name="email" class="form-control" required placeholder="请输入邮箱" autocomplete="email">
      </div>
      <div class="form-group">
        <label>密码</label>
        <input type="password" name="password" class="form-control" required placeholder="至少 6 位密码" minlength="6" autocomplete="new-password">
      </div>
      <div class="form-group">
        <label>确认密码</label>
        <input type="password" name="confirm_password" class="form-control" required placeholder="再次输入密码" autocomplete="new-password">
      </div>
      <button type="submit" class="btn btn-primary btn-block btn-lg">创建账号</button>
    </form>
    <p class="auth-footer">已有账号？<a href="/auth/login">立即登录</a></p>
  </div>

<%- include('../partials/foot') %>
