<%- include('../partials/head', { title: '添加就诊' }) %>

<div class="page-header">
  <h1>🏥 添加就诊记录</h1>
  <a href="/medical" class="btn btn-outline">← 返回</a>
</div>

<div class="card">
  <form action="/medical" method="POST" enctype="multipart/form-data">
    <div class="form-grid">
      <div class="form-group">
        <label>选择宠物 *</label>
        <select name="pet_id" class="form-control" required>
          <option value="">请选择宠物</option>
          <% pets.forEach(p => { %><option value="<%= p.id %>"><%= p.name %></option><% }) %>
        </select>
      </div>
      <div class="form-group">
        <label>就诊日期 *</label>
        <input type="date" name="visit_date" class="form-control" required>
      </div>
      <div class="form-group">
        <label>服务商</label>
        <select name="provider_id" class="form-control">
          <option value="">不关联</option>
          <% providers.forEach(provider => { %><option value="<%= provider.id %>"><%= provider.name %> · <%= provider.type %></option><% }) %>
        </select>
      </div>
      <div class="form-group">
        <label>兽医姓名</label>
        <input type="text" name="vet_name" class="form-control" placeholder="例如：李医生">
      </div>
      <div class="form-group">
        <label>诊所名称</label>
        <input type="text" name="vet_clinic" class="form-control" placeholder="例如：安心动物医院">
      </div>
      <div class="form-group">
        <label>费用 (¥)</label>
        <input type="number" step="0.01" name="cost" class="form-control" value="0">
      </div>
      <div class="form-group">
        <label>下次就诊</label>
        <input type="date" name="next_visit" class="form-control">
      </div>
      <div class="form-group">
        <label>📎 附件</label>
        <div class="file-upload-hint" style="padding:12px 16px;background:var(--bg-alt);border-radius:var(--radius-md);border:2px dashed var(--border);text-align:center;color:var(--text-muted);font-size:0.85rem;margin-bottom:8px;">
          🖼️ 支持图片、PDF、Word、TXT 等格式文件
        </div>
        <input type="file" name="attachment" class="form-control" accept="image/*,.pdf,.doc,.docx,.txt">
      </div>
    </div>
    <div class="form-group">
      <label>诊断</label>
      <textarea name="diagnosis" class="form-control" placeholder="诊断结果..."></textarea>
    </div>
    <div class="form-group">
      <label>治疗方案</label>
      <textarea name="treatment" class="form-control" placeholder="治疗措施、用药建议..."></textarea>
    </div>
    <div class="form-group">
      <label>备注</label>
      <textarea name="notes" class="form-control" placeholder="其他注意事项..."></textarea>
    </div>
    <button type="submit" class="btn btn-primary">💾 保存记录</button>
  </form>
</div>

<%- include('../partials/foot') %>
