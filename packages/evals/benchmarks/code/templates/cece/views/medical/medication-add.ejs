<%- include('../partials/head', { title: '添加药品' }) %>

<div class="page-header">
  <h1>💊 添加药品</h1>
  <a href="/medical" class="btn btn-outline">← 返回</a>
</div>

<div class="card">
  <form action="/medical/medications" method="POST">
    <div class="form-grid">
      <div class="form-group">
        <label>选择宠物 *</label>
        <select name="pet_id" class="form-control" required>
          <option value="">请选择宠物</option>
          <% pets.forEach(p => { %><option value="<%= p.id %>"><%= p.name %></option><% }) %>
        </select>
      </div>
      <div class="form-group">
        <label>药品名称 *</label>
        <input type="text" name="medicine_name" class="form-control" required placeholder="例如：阿莫西林">
      </div>
      <div class="form-group">
        <label>剂量</label>
        <input type="text" name="dosage" class="form-control" placeholder="例如：1片/次">
      </div>
      <div class="form-group">
        <label>频率</label>
        <input type="text" name="frequency" class="form-control" placeholder="例如：每日2次">
      </div>
      <div class="form-group">
        <label>提醒时间</label>
        <input type="time" name="dose_time" class="form-control" value="09:00">
      </div>
      <div class="form-group">
        <label>开始日期 *</label>
        <input type="date" name="start_date" class="form-control" required>
      </div>
      <div class="form-group">
        <label>结束日期</label>
        <input type="date" name="end_date" class="form-control">
      </div>
    </div>
    <div class="form-group">
      <label>备注</label>
      <textarea name="notes" class="form-control" placeholder="用药注意事项..."></textarea>
    </div>
    <button type="submit" class="btn btn-primary">💾 保存药品</button>
  </form>
</div>

<%- include('../partials/foot') %>
