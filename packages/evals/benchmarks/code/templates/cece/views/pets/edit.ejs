<%- include('../partials/head', { title: '编辑宠物' }) %>

<div class="page-header">
  <div>
    <a href="/pets/<%= pet.id %>" class="back-link">← 返回 <%= pet.name %> 档案</a>
    <div class="page-kicker">资料维护</div>
    <h1>✏️ 编辑宠物</h1>
    <p class="page-subtitle">更新 <%= pet.name %> 的资料与健康信息</p>
  </div>
</div>

<form action="/pets/<%= pet.id %>" method="POST" enctype="multipart/form-data" class="pet-form">

  <!-- ── 基本信息 ── -->
  <div class="section pet-form-section">
    <div class="section-header"><h2>📋 基本信息</h2></div>
    <div class="form-grid">
      <div class="form-group">
        <label>宠物名称 *</label>
        <input type="text" name="name" class="form-control" required value="<%= pet.name %>">
      </div>
      <div class="form-group">
        <label>种类</label>
        <select name="species" class="form-control">
          <% ['狗','猫','鸟','鱼','兔子','仓鼠','其他'].forEach(s => { %>
          <option value="<%= s %>" <%= pet.species === s ? 'selected' : '' %>><%= s %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label>品种</label>
        <input type="text" name="breed" class="form-control" value="<%= pet.breed %>">
      </div>
      <div class="form-group">
        <label>性别</label>
        <select name="gender" class="form-control">
          <% ['未知','公','母'].forEach(g => { %>
          <option value="<%= g %>" <%= pet.gender === g ? 'selected' : '' %>><%= g %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label>出生日期</label>
        <input type="date" name="birth_date" class="form-control" value="<%= pet.birth_date %>">
      </div>
      <div class="form-group">
        <label>体重 (kg)</label>
        <input type="number" step="0.1" name="weight" class="form-control" value="<%= pet.weight %>">
      </div>
    </div>
  </div>

  <!-- ── 详细资料 ── -->
  <div class="section pet-form-section">
    <div class="section-header"><h2>🔍 详细资料</h2></div>
    <div class="form-grid">
      <div class="form-group">
        <label>芯片号</label>
        <input type="text" name="microchip" class="form-control" value="<%= pet.microchip %>" placeholder="例如：900123456789012">
      </div>
      <div class="form-group">
        <label>颜色 / 花纹</label>
        <input type="text" name="color" class="form-control" value="<%= pet.color %>" placeholder="例如：虎斑、纯白、黑白相间">
      </div>
      <div class="form-group">
        <label>主治兽医 ID</label>
        <input type="number" name="provider_id" class="form-control" value="<%= pet.provider_id %>" placeholder="关联兽医编号">
      </div>
      <div class="form-group">
        <label>过敏信息</label>
        <input type="text" name="allergies" class="form-control" value="<%= pet.allergies %>" placeholder="例如：花粉、某种食物、无">
      </div>
      <div class="form-group">
        <label>宠物保险</label>
        <input type="text" name="insurance" class="form-control" value="<%= pet.insurance %>" placeholder="保险公司名称 / 保单号">
      </div>
      <div class="form-group">
        <div class="checkbox-group">
          <input type="checkbox" name="neutered" id="neuteredEdit" value="1" <%= pet.neutered ? 'checked' : '' %>>
          <label for="neuteredEdit">已绝育</label>
        </div>
      </div>
    </div>
  </div>

  <!-- ── 照片 ── -->
  <div class="section pet-form-section">
    <div class="section-header"><h2>📸 照片</h2></div>
    <% if (pet.photo) { %>
    <div class="photo-preview">
      <img src="<%= pet.photo %>" alt="<%= pet.name %>">
      <div class="photo-preview-info">
        <p class="photo-preview-label">当前照片</p>
        <p class="photo-preview-hint">上传新照片将自动替换</p>
      </div>
    </div>
    <% } %>
    <div class="file-upload-zone">
      <span class="file-upload-icon">🖼️</span>
      <span>支持 JPG、PNG、GIF 格式，留空则不更换照片</span>
    </div>
    <input type="file" name="photo" class="form-control" accept="image/*" style="margin-top:12px;">
  </div>

  <!-- ── 备注 ── -->
  <div class="section pet-form-section">
    <div class="section-header"><h2>📝 备注</h2></div>
    <textarea name="notes" class="form-control" placeholder="宠物特点、喜好、注意事项等..."><%= pet.notes %></textarea>
  </div>

  <!-- ── 操作按钮 ── -->
  <div class="form-actions">
    <a href="/pets/<%= pet.id %>" class="btn btn-outline">取消</a>
    <button type="submit" class="btn btn-primary">💾 保存修改</button>
  </div>

</form>

<%- include('../partials/foot') %>
