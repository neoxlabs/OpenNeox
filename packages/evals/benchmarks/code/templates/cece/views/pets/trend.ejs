<%- include('../partials/head', { title: title }) %>
<%
  const safeNum = (v, fallback = 0) => { const x = Number(v); return Number.isFinite(x) ? Math.round(x) : fallback; };
  const series = trend.series || [];
  const summary = trend.summary || {};
  const metrics = [
    { key: 'happiness', label: '心情', emoji: '😊', color: '#E78B96', bg: 'rgba(231,139,150,0.14)' },
    { key: 'hunger', label: '饱腹', emoji: '🍖', color: '#F0C878', bg: 'rgba(240,200,120,0.14)' },
    { key: 'energy', label: '精力', emoji: '⚡', color: '#7EC8C4', bg: 'rgba(126,200,196,0.14)' },
    { key: 'health', label: '健康', emoji: '💚', color: '#7EC8A0', bg: 'rgba(126,200,160,0.14)' }
  ];

  function trendArrow(t) {
    if (t === 'up') return '↑';
    if (t === 'down') return '↓';
    return '→';
  }
  function trendClass(t) {
    if (t === 'up') return 'trend-up';
    if (t === 'down') return 'trend-down';
    return 'trend-flat';
  }
  function deltaText(d) {
    if (d > 0) return '+' + d;
    return String(d);
  }

  // SVG chart geometry
  const W = 640;
  const H = 220;
  const padL = 36;
  const padR = 16;
  const padT = 18;
  const padB = 32;
  const plotW = W - padL - padR;
  const plotH = H - padT - padB;
  const n = Math.max(series.length, 1);

  function xAt(i) {
    if (n === 1) return padL + plotW / 2;
    return padL + (i / (n - 1)) * plotW;
  }
  function yAt(v) {
    const clamped = Math.max(0, Math.min(100, Number(v) || 0));
    return padT + plotH * (1 - clamped / 100);
  }
  function linePath(key) {
    return series.map((p, i) => {
      const x = xAt(i).toFixed(1);
      const y = yAt(p[key]).toFixed(1);
      return (i === 0 ? 'M' : 'L') + x + ',' + y;
    }).join(' ');
  }
  function areaPath(key) {
    if (!series.length) return '';
    const line = linePath(key);
    const lastX = xAt(series.length - 1).toFixed(1);
    const firstX = xAt(0).toFixed(1);
    const baseY = (padT + plotH).toFixed(1);
    return line + ' L' + lastX + ',' + baseY + ' L' + firstX + ',' + baseY + ' Z';
  }
  const yTicks = [0, 25, 50, 75, 100];
%>

<style>
  .trend-summary-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin-bottom: 24px;
  }
  .trend-stat-card {
    background: var(--surface);
    backdrop-filter: blur(var(--glass-blur));
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    padding: 16px 18px;
    box-shadow: var(--shadow-sm);
    position: relative;
    overflow: hidden;
  }
  .trend-stat-card::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 4px;
    border-radius: 4px 0 0 4px;
    background: var(--card-accent, var(--primary));
  }
  .trend-stat-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
    font-size: 0.88rem;
    color: var(--text-muted);
    font-weight: 700;
  }
  .trend-stat-value {
    font-size: 1.85rem;
    font-weight: 800;
    letter-spacing: -0.5px;
    color: var(--text);
    line-height: 1.1;
  }
  .trend-stat-meta {
    margin-top: 8px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 12px;
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  .trend-delta {
    font-weight: 800;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 0.75rem;
  }
  .trend-up { color: #3d9b6e; background: var(--green-bg); }
  .trend-down { color: #c45a68; background: var(--red-bg); }
  .trend-flat { color: var(--text-muted); background: rgba(133,120,144,0.12); }

  .trend-days-nav {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }
  .trend-days-nav .btn.active {
    background: var(--primary-gradient);
    color: #fff;
    border-color: transparent;
    box-shadow: var(--shadow-primary);
  }

  .trend-chart-card {
    background: var(--surface);
    backdrop-filter: blur(var(--glass-blur));
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    padding: 18px 16px 12px;
    box-shadow: var(--shadow-sm);
    margin-bottom: 20px;
  }
  .trend-chart-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 18px;
    margin-bottom: 10px;
    padding: 0 8px;
  }
  .trend-legend-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text-muted);
  }
  .trend-legend-dot {
    width: 10px; height: 10px;
    border-radius: 50%;
    box-shadow: 0 0 0 2px rgba(255,255,255,0.6);
  }
  .trend-svg-wrap {
    width: 100%;
    overflow-x: auto;
  }
  .trend-svg {
    width: 100%;
    min-width: 480px;
    height: auto;
    display: block;
  }
  .trend-grid-line {
    stroke: var(--border);
    stroke-width: 1;
    stroke-dasharray: 3 4;
  }
  .trend-axis-label {
    fill: var(--text-muted);
    font-size: 11px;
    font-family: inherit;
  }
  .trend-point {
    stroke: #fff;
    stroke-width: 2;
  }

  .trend-bars-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  .trend-bar-card {
    background: var(--surface);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    padding: 16px;
    box-shadow: var(--shadow-sm);
  }
  .trend-bar-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
    font-weight: 800;
  }
  .trend-bar-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }
  .trend-bar-label {
    width: 42px;
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 700;
    flex-shrink: 0;
  }
  .trend-bar-track {
    flex: 1;
    height: 12px;
    background: rgba(176,160,188,0.12);
    border-radius: 999px;
    overflow: hidden;
  }
  .trend-bar-fill {
    height: 100%;
    border-radius: 999px;
    min-width: 2px;
    transition: width 0.35s ease;
  }
  .trend-bar-val {
    width: 36px;
    text-align: right;
    font-size: 0.78rem;
    font-weight: 800;
    color: var(--text);
  }
  .trend-note {
    margin-top: 8px;
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  @media (max-width: 860px) {
    .trend-summary-grid { grid-template-columns: repeat(2, 1fr); }
    .trend-bars-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .trend-summary-grid { grid-template-columns: 1fr; }
  }
</style>

<div class="page-header">
  <div>
    <a href="/pets/<%= pet.id %>" class="back-link">← 返回详情</a>
    <div class="page-kicker">健康洞察</div>
    <h1>📈 <%= pet.name %> · 健康趋势</h1>
    <p class="page-subtitle">近 <%= days %> 天心情 / 饱腹 / 精力 / 健康变化<%= trend.generated ? '（基于当前状态推演）' : '' %></p>
  </div>
  <div class="page-header-actions">
    <a href="/report/<%= pet.id %>" class="btn btn-outline">📋 健康月报</a>
    <a href="/pets/<%= pet.id %>" class="btn btn-primary">档案</a>
  </div>
</div>

<div class="trend-days-nav">
  <span style="font-size:0.85rem;color:var(--text-muted);font-weight:700;">时间范围</span>
  <% [7, 14, 30].forEach(function(d) { %>
  <a href="/pets/<%= pet.id %>/trend?days=<%= d %>" class="btn btn-outline btn-sm <%= days === d ? 'active' : '' %>"><%= d %> 天</a>
  <% }) %>
</div>

<% if (series.length === 0) { %>
<div class="empty-state">
  <span class="empty-icon">📉</span>
  <p>暂无趋势数据</p>
  <p class="empty-hint">系统尚未收集到足够的状态快照，趋势图将在日常使用后自动生成。</p>
</div>
<% } else { %>

<!-- Summary cards -->
<div class="trend-summary-grid">
  <% metrics.forEach(function(m) {
    const s = summary[m.key] || { current: 0, avg: 0, min: 0, max: 0, delta: 0, trend: 'flat' };
  %>
  <div class="trend-stat-card" style="--card-accent:<%= m.color %>">
    <div class="trend-stat-head">
      <span><%= m.emoji %> <%= m.label %></span>
      <span class="trend-delta <%= trendClass(s.trend) %>"><%= trendArrow(s.trend) %> <%= deltaText(s.delta) %></span>
    </div>
    <div class="trend-stat-value"><%= s.current %><span style="font-size:0.9rem;color:var(--text-muted);font-weight:700">%</span></div>
    <div class="trend-stat-meta">
      <span>均值 <%= s.avg %></span>
      <span>区间 <%= s.min %>–<%= s.max %></span>
    </div>
  </div>
  <% }) %>
</div>

<!-- Combined line chart (SVG) -->
<div class="section">
  <div class="section-header"><h2>📉 综合折线趋势</h2></div>
  <div class="trend-chart-card">
    <div class="trend-chart-legend">
      <% metrics.forEach(function(m) { %>
      <span class="trend-legend-item">
        <span class="trend-legend-dot" style="background:<%= m.color %>"></span>
        <%= m.emoji %> <%= m.label %>
      </span>
      <% }) %>
    </div>
    <div class="trend-svg-wrap">
      <svg class="trend-svg" viewBox="0 0 <%= W %> <%= H %>" role="img" aria-label="宠物状态趋势折线图">
        <!-- grid -->
        <% yTicks.forEach(function(tick) {
          const y = yAt(tick).toFixed(1);
        %>
        <line class="trend-grid-line" x1="<%= padL %>" y1="<%= y %>" x2="<%= W - padR %>" y2="<%= y %>" />
        <text class="trend-axis-label" x="<%= padL - 8 %>" y="<%= Number(y) + 3 %>" text-anchor="end"><%= tick %></text>
        <% }) %>

        <!-- soft area for health as baseline -->
        <path d="<%= areaPath('health') %>" fill="rgba(126,200,160,0.12)" stroke="none" />

        <!-- lines -->
        <% metrics.forEach(function(m) { %>
        <path d="<%= linePath(m.key) %>" fill="none" stroke="<%= m.color %>" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.95" />
        <% }) %>

        <!-- points + x labels -->
        <% series.forEach(function(p, i) {
          const x = xAt(i);
          const showLabel = n <= 10 || i === 0 || i === n - 1 || i % Math.ceil(n / 7) === 0;
        %>
          <% metrics.forEach(function(m) { %>
            <circle class="trend-point" cx="<%= x.toFixed(1) %>" cy="<%= yAt(p[m.key]).toFixed(1) %>" r="3.5" fill="<%= m.color %>">
              <title><%= p.date %> · <%= m.label %>: <%= safeNum(p[m.key]) %></title>
          </circle>
          <% }) %>
          <% if (showLabel) { %>
          <text class="trend-axis-label" x="<%= x.toFixed(1) %>" y="<%= H - 10 %>" text-anchor="middle"><%= p.label %></text>
          <% } %>
        <% }) %>
      </svg>
    </div>
    <% if (trend.generated) { %>
    <p class="trend-note">当前系统仅保存最新状态快照，图中历史点由当前值确定性推演生成，便于预览趋势页；接入真实历史表后可无缝替换数据源。</p>
    <% } %>
  </div>
</div>

<!-- Per-metric daily bars -->
<div class="section">
  <div class="section-header"><h2>📊 分项每日柱状</h2></div>
  <div class="trend-bars-grid">
    <% metrics.forEach(function(m) { %>
    <div class="trend-bar-card">
      <div class="trend-bar-title">
        <span><%= m.emoji %> <%= m.label %></span>
        <% const s = summary[m.key] || {}; %>
        <span class="trend-delta <%= trendClass(s.trend) %>"><%= trendArrow(s.trend) %> <%= deltaText(s.delta || 0) %></span>
      </div>
      <% series.forEach(function(p) { %>
      <div class="trend-bar-row">
        <div class="trend-bar-label"><%= p.label %></div>
        <div class="trend-bar-track">
          <div class="trend-bar-fill" style="width:<%= safeNum(p[m.key]) %>%;background:<%= m.color %>;"></div>
        </div>
        <div class="trend-bar-val"><%= safeNum(p[m.key]) %></div>
      </div>
      <% }) %>
    </div>
    <% }) %>
  </div>
</div>

<% } %>

<%- include('../partials/foot') %>
