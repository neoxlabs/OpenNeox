<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Nunito', -apple-system, BlinkMacSystemFont, sans-serif;
      background:
        radial-gradient(ellipse 80% 60% at 15% 10%, rgba(168, 216, 234, 0.28), transparent 55%),
        radial-gradient(ellipse 70% 50% at 90% 20%, rgba(231, 139, 150, 0.18), transparent 50%),
        linear-gradient(160deg, #F8F4F7 0%, #F1EBF2 100%);
      min-height: 100vh;
      display: flex; align-items: center; justify-content: center;
      padding: 24px;
      color: #3A3042;
    }
    .card {
      width: 420px; max-width: 100%;
      background: rgba(255,255,255,0.92);
      border: 1px solid rgba(255,255,255,0.8);
      border-radius: 28px;
      box-shadow: 0 18px 48px rgba(176, 152, 190, 0.18);
      overflow: hidden;
      backdrop-filter: blur(12px);
    }
    .card-header {
      background: linear-gradient(135deg, #E78B96 0%, #F0B8BF 45%, #B9A8D8 100%);
      padding: 32px 28px 28px;
      text-align: center;
      color: white;
      position: relative;
    }
    .card-header::after {
      content: '';
      position: absolute; bottom: -1px; left: 0; right: 0; height: 22px;
      background: radial-gradient(circle at 12px 0, transparent 11px, rgba(255,255,255,0.92) 12px) 0 0 / 24px 22px repeat-x;
    }
    .card-photo {
      width: 108px; height: 108px;
      border-radius: 28px;
      border: 4px solid rgba(255,255,255,0.65);
      margin: 0 auto 14px;
      overflow: hidden;
      background: rgba(255,255,255,0.22);
      display: flex; align-items: center; justify-content: center;
      box-shadow: 0 10px 28px rgba(231, 139, 150, 0.28);
    }
    .card-photo img { width: 100%; height: 100%; object-fit: cover; }
    .card-name { font-size: 1.7rem; font-weight: 800; letter-spacing: -0.3px; }
    .card-badge {
      display: inline-flex; margin-top: 8px; padding: 4px 12px;
      border-radius: 999px; font-size: 0.85rem; font-weight: 700;
      background: rgba(255,255,255,0.22); border: 1px solid rgba(255,255,255,0.35);
    }
    .card-body { padding: 28px 28px 24px; }
    .card-id {
      display: flex; align-items: center; justify-content: center;
      gap: 6px; margin-bottom: 22px;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.9rem; font-weight: 700;
      color: #857890;
      background: #F7F3F8; padding: 10px 16px; border-radius: 14px;
      border: 1px solid rgba(198, 182, 208, 0.35);
    }
    .info-grid {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 14px 18px; margin-bottom: 20px;
    }
    .info-item {
      background: linear-gradient(180deg, #FBF8FC, #F7F3F8);
      border: 1px solid rgba(198, 182, 208, 0.28);
      border-radius: 14px;
      padding: 12px 14px;
    }
    .info-label {
      font-size: 0.7rem; color: #C4B8CC; text-transform: uppercase;
      letter-spacing: 0.5px; font-weight: 800; margin-bottom: 4px;
    }
    .info-value { font-size: 0.95rem; font-weight: 700; color: #3A3042; line-height: 1.4; }
    .info-alert {
      grid-column: 1 / -1;
      background: rgba(231,139,150,0.1);
      border: 1px solid rgba(231,139,150,0.22);
      border-radius: 14px; padding: 12px 16px;
    }
    .info-alert .info-label { color: #E78B96; }
    .info-alert .info-value { color: #D67582; }
    .vaccine-list { margin-bottom: 18px; }
    .vaccine-list h3 {
      font-size: 0.85rem; color: #857890; margin-bottom: 10px; font-weight: 800;
    }
    .vaccine-item {
      display: flex; justify-content: space-between; gap: 10px;
      padding: 8px 12px; background: #F7F3F8; border-radius: 10px;
      margin-bottom: 6px; font-size: 0.82rem; font-weight: 700;
      border: 1px solid rgba(198, 182, 208, 0.22);
    }
    .vaccine-item span:last-child { color: #8B7D94; font-weight: 600; white-space: nowrap; }
    .card-footer {
      text-align: center; padding-top: 16px;
      border-top: 1px solid rgba(200,185,210,0.3);
      color: #C4B8CC; font-size: 0.75rem; font-weight: 700;
    }
    .print-btn {
      display: block; width: 100%; margin-top: 16px;
      padding: 12px; border: none;
      background: linear-gradient(135deg, #E78B96, #F3B7C0);
      color: white; border-radius: 999px;
      font-size: 0.95rem; font-weight: 800;
      cursor: pointer; box-shadow: 0 8px 22px rgba(231,139,150,0.28);
      font-family: inherit;
      transition: transform 0.18s ease, box-shadow 0.18s ease;
    }
    .print-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 28px rgba(231,139,150,0.34);
    }
    @media (max-width: 480px) {
      body { padding: 16px; }
      .card-body { padding: 22px 18px 18px; }
      .info-grid { grid-template-columns: 1fr; }
      .card-photo { width: 96px; height: 96px; border-radius: 24px; }
    }
    @media print {
      body { background: white; padding: 0; }
      .card { box-shadow: none; border-radius: 0; border: none; }
      .print-btn { display: none; }
      .card-header::after { display: none; }
    }
  </style>
</head>
<body>
<div class="card">
  <div class="card-header">
    <div class="card-photo">
      <% if (pet.photo) { %><img src="<%= pet.photo %>" alt="<%= pet.name %>"><% } else { %><span style="font-size:2.5rem;">🐾</span><% } %>
    </div>
    <div class="card-name"><%= pet.name %></div>
    <div class="card-badge"><%= pet.species %> · <%= pet.breed || '品种未填' %></div>
  </div>
  <div class="card-body">
    <div class="card-id">🆔 <%= pet.microchip || 'NO-' + String(pet.id).padStart(6, '0') %></div>

    <div class="info-grid">
      <div class="info-item">
        <div class="info-label">性别 / 绝育</div>
        <div class="info-value"><%= pet.gender %> · <%= pet.neutered ? '已绝育' : '未绝育' %></div>
      </div>
      <div class="info-item">
        <div class="info-label">出生日期</div>
        <div class="info-value"><%= pet.birth_date || '未知' %></div>
      </div>
      <div class="info-item">
        <div class="info-label">年龄</div>
        <div class="info-value"><%= age || '未知' %></div>
      </div>
      <div class="info-item">
        <div class="info-label">体重</div>
        <div class="info-value"><%= weight ? weight.weight + ' kg' : (pet.weight + ' kg') %></div>
      </div>
      <div class="info-item">
        <div class="info-label">颜色 / 花纹</div>
        <div class="info-value"><%= pet.color || '未记录' %></div>
      </div>
      <div class="info-item">
        <div class="info-label">保险</div>
        <div class="info-value"><%= pet.insurance || '未投保' %></div>
      </div>

      <% if (pet.allergies) { %>
      <div class="info-alert">
        <div class="info-label">⚠️ 过敏信息</div>
        <div class="info-value"><%= pet.allergies %></div>
      </div>
      <% } %>

      <% if (provider) { %>
      <div class="info-item" style="grid-column: 1 / -1;">
        <div class="info-label">兽医</div>
        <div class="info-value"><%= provider.name %> · <%= provider.phone %></div>
      </div>
      <% } %>
    </div>

    <% if (vaccines && vaccines.length > 0) { %>
    <div class="vaccine-list">
      <h3>💉 最近疫苗接种</h3>
      <% vaccines.forEach(v => { %>
      <div class="vaccine-item">
        <span><%= v.vaccine_name %></span>
        <span><%= v.vaccine_date %><% if (v.next_date) { %> → <%= v.next_date %><% } %></span>
      </div>
      <% }) %>
    </div>
    <% } %>

    <div class="card-footer">
      🐾 由 Cece 宠物管家生成 · 扫码联系主人
    </div>
    <button class="print-btn" onclick="window.print()">🖨️ 打印身份证</button>
  </div>
</div>
</body>
</html>
