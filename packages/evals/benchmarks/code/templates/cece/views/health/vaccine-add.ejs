<%- include('../partials/head', { title: '添加疫苗' }) %>

<div class="page-header">
  <h1>💉 添加疫苗记录</h1>
  <a href="/health" class="btn btn-outline">← 返回</a>
</div>

<div class="card">
  <form action="/health/vaccines" method="POST">
    <div class="form-grid">
      <div class="form-group">
        <label>选择宠物 *</label>
        <select name="pet_id" class="form-control" required>
          <option value="">请选择宠物</option>
          <% pets.forEach(p => { %><option value="<%= p.id %>"><%= p.name %></option><% }) %>
        </select>
      </div>
      <div class="form-group">
        <label>疫苗名称 *</label>
        <input type="text" name="vaccine_name" class="form-control" required placeholder="例如：狂犬疫苗">
      </div>
      <div class="form-group">
        <label>接种日期 *</label>
        <input type="date" name="vaccine_date" class="form-control" required>
      </div>
      <div class="form-group">
        <label>下次接种</label>
        <input type="date" name="next_date" class="form-control">
      </div>
      <div class="form-group">
        <label>兽医诊所</label>
        <input type="text" name="vet_clinic" class="form-control" placeholder="例如：安心动物医院">
      </div>
    </div>
    <div class="form-group">
      <label>备注</label>
      <textarea name="notes" class="form-control" placeholder="疫苗批号、反应等..."></textarea>
    </div>
    <button type="submit" class="btn btn-primary">💾 保存记录</button>
  </form>
</div>

<%- include('../partials/foot') %>
