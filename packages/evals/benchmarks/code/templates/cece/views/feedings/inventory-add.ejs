<%- include('../partials/head', { title: '添加食物' }) %>

<div class="page-header">
  <h1>📦 添加食物</h1>
  <a href="/feedings/inventory" class="btn btn-outline">← 返回库存</a>
</div>

<div class="section">
  <form action="/feedings/inventory" method="POST">
    <div class="form-grid">
      <div class="form-group">
        <label>🐾 宠物</label>
        <select name="pet_id" class="form-control">
          <option value="">通用（不限宠物）</option>
          <% if (typeof pets !== 'undefined') { pets.forEach(function(p) { %>
          <option value="<%= p.id %>"><%= p.name %></option>
          <% }) } %>
        </select>
      </div>

      <div class="form-group">
        <label>🏷️ 品牌 *</label>
        <input type="text" name="brand" class="form-control" required placeholder="例如：皇家、冠能">
      </div>

      <div class="form-group">
        <label>🍽️ 食物类型</label>
        <select name="food_type" class="form-control">
          <option value="干粮">干粮</option>
          <option value="湿粮">湿粮</option>
          <option value="零食">零食</option>
          <option value="snack">小吃</option>
        </select>
      </div>

      <div class="form-group">
        <label>🍗 口味</label>
        <input type="text" name="flavor" class="form-control" placeholder="例如：鸡肉味、三文鱼">
      </div>

      <div class="form-group">
        <label>⚖️ 总重量(克)</label>
        <input type="number" name="total_grams" class="form-control" value="0" min="0" step="0.1">
      </div>

      <div class="form-group">
        <label>📊 剩余重量(克)</label>
        <input type="number" name="remaining_grams" class="form-control" value="0" min="0" step="0.1">
      </div>

      <div class="form-group">
        <label>📅 购买日期</label>
        <input type="date" name="purchase_date" class="form-control">
      </div>

      <div class="form-group">
        <label>⏳ 保质期</label>
        <input type="date" name="expiry_date" class="form-control">
      </div>
    </div>

    <div class="form-group">
      <label>📝 备注</label>
      <textarea name="notes" class="form-control" placeholder="额外记录..."></textarea>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">💾 保存</button>
      <a href="/feedings/inventory" class="btn btn-outline">取消</a>
    </div>
  </form>
</div>

<%- include('../partials/foot') %>
